<div class="widget carousel" data-scroll-speed="{{scrollSpeed}}" data-auto-scroll="{{autoScroll}}" style="--background-color: {{background}}; --text-color: {{text}}" aria-label="Customer Reviews">
  <div class="scroll-container">
    <div class="scroll-content">
      {{#each reviewsData}}
        <div class="review-item" tabindex="0">
          <span class="reviewer-name">{{this.name}}</span>
          <p class="review-content">{{this.content}}</p>
          <div class="stars" aria-label="{{this.rating}} out of 5 stars">
            {{#times 5}}
              <span class="star {{#if (lte @index ../rating)}}filled{{/if}}"></span>
            {{/times}}
          </div>
          {{#unless ../hideDate}}
            <span class="review-date">{{formatDate this.createdAt}}</span>
          {{/unless}}
        </div>
      {{/each}}
    </div>
  </div>
  <div class="arrow-wrap left-arrow-wrap">
    <div class="arrow" id="leftArrow"></div>
  </div>
  <div class="arrow-wrap right-arrow-wrap">
    <div class="arrow" id="rightArrow"></div>
  </div>
</div>
