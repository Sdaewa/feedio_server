<div
  class="widget average_card"
  style="--background-color: {{background}}; --text-color: {{text}}"
>
  <div
    class="stars"
    style="--rating-width: {{multiply
      (toFixed productData.averageRating 1)
      20
    }}%;"
  >★★★★★</div>
  <p>{{toFixed productData.averageRating 1}}
    average based on
    {{reviewsLength}}
    reviews.</p>
</div>