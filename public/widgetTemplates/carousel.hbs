<div class="widget carousel" style="--background-color: {{backgroundColor}}; --text-color: {{textColor}}" aria-label="Customer Reviews" data-autoscroll="{{autoScroll}}">
  <div class="carousel-container">
    <div class="carousel-track">
      {{#each reviewsData}}
        <div class="carousel-slide" tabindex="0">
          <div class="review-content-wrapper">
            <span class="reviewer-name">{{this.name}}</span>
            <p class="review-content">{{this.content}}</p>
            <div class="review-footer">
              <div class="stars" style="--rating-width: {{multiply this.rating 20}}%" aria-label="{{this.rating}} out of 5 stars">★★★★★</div>
              {{#unless ../hideDate}}
                <div class="review-date">{{formatDate this.createdAt}}</div>
              {{/unless}}
            </div>
          </div>
        </div>
      {{/each}}
    </div>
    
    <button class="carousel-button prev" aria-label="Previous slide">
      <svg viewBox="0 0 24 24" width="24" height="24">
        <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z" fill="currentColor"/>
      </svg>
    </button>
    <button class="carousel-button next" aria-label="Next slide">
      <svg viewBox="0 0 24 24" width="24" height="24">
        <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z" fill="currentColor"/>
      </svg>
    </button>
    
    <div class="carousel-indicators">
      {{#each reviewsData}}
        <button class="indicator{{#if @first}} active{{/if}}" data-slide="{{@index}}" aria-label="Slide"></button>
      {{/each}}
    </div>
  </div>
</div>
