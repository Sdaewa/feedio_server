<div class="feedback-container">
  <div class="content-container">
    <h1 class="text-center">Share Your Thoughts</h1>
    <h3 class="text-center product-header">{{productData.header}}</h3>

    <div class="product-questions">
      <ul>
        {{#each productData.questions}}
          <li>{{this}}</li>
        {{/each}}
      </ul>
    </div>

    <form id="feedback-form" class="feedback-form">
      <input type="hidden" name="productId" value="{{productId}}" />

      <div class="input-field">
        <label for="name">Name</label>
        <input type="text" id="name" name="name" required />
      </div>

      <div class="input-field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required />
      </div>

      <div class="input-field">
        <label for="feedback">Feedback</label>
        <textarea
          id="feedback"
          name="feedback"
          rows="3"
          required
          minlength="100"
        ></textarea>
        <small class="char-count">0/100 characters</small>
      </div>

      <div class="input-field">
        <label>Rating</label>
        <div class="star-rating">
          {{#each (range 1 6)}}
            <span class="star" data-value="{{this}}">★</span>
          {{/each}}
        </div>
      </div>

      <div class="input-field nps-score">
        <label>
          How likely are you to recommend our product/service to a friend or
          colleague?
        </label>
        <div class="nps-score-options">
          <span>Very unlikely</span>
          {{#each (range 0 11)}}
            <label class="nps-option">
              <input
                type="radio"
                name="npsScore"
                value="{{this}}"
                id="nps-{{this}}"
              />
              <span class="nps-badge">{{this}}</span>
            </label>
          {{/each}}
          <span>Very likely</span>
        </div>
      </div>

      <div class="submit-container">
        <button type="submit" class="submit-btn">Submit Feedback</button>
      </div>
    </form>
  </div>
</div>
<script src="/scripts/sendForm.js"></script>