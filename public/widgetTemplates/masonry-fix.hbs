<div class="widget masonry_fix" style="--background-color: {{background}}; --text-color: {{text}}">
  {{#each reviewsData}}
    <div class="review-item">
      <div class="avatar-container">
        <img class="avatar" src="https://ui-avatars.com/api/?name={{this.name}}&background=random&color=fff" alt="{{this.name}}'s avatar">
        <span class="reviewer-name">{{this.name}}</span>
      </div>
      <p class="review-content">{{this.content}}</p>
      <div class="review-footer">
        <span class="stars" data-rating="{{this.rating}}"></span>
        {{#unless ../hideDate}}
          <span class="review-date">{{this.createdAt}}</span>
        {{/unless}}
      </div>
    </div>
  {{/each}}
</div>