<div class="widget masonry_fix" style="--background-color: {{background}}; --text-color: {{text}}" aria-label="Customer Reviews">
  {{#each reviewsData}}
    <div class="review-item" tabindex="0">
      <span class="reviewer-name">{{this.name}}</span>
      <p class="review-content">{{this.content}}</p>
      <div class="stars" style="--rating-width: {{multiply this.rating 20}}%" aria-label="{{this.rating}} out of 5 stars">★★★★★</div>
      <div class="review-footer">
        {{#unless ../hideDate}}
          <span class="review-date">{{formatDate this.createdAt}}</span>
        {{/unless}}
      </div>
    </div>
  {{/each}}
</div>